# Environment Configuration
ENVIRONMENT=development

# Storage Mode (local or s3)
STORAGE_MODE=local
# STORAGE_MODE=s3

# Database Configuration
DATABASE_URL=postgresql://admin:development@localhost:5432/omnigraph_osint
# For RDS in AWS:
# DATABASE_URL=postgresql://admin:your-password@instance.region.rds.amazonaws.com:5432/omnigraph

# AWS Configuration (required if STORAGE_MODE=s3)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
S3_BUCKET_NAME=omnigraph-dev-evidence
S3_FRONTEND_BUCKET=omnigraph-dev-frontend
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/omnigraph-processing

# API Configuration
API_BASE_URL=http://localhost:8000
# For production:
# API_BASE_URL=https://api.omnigraph.example.com

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Processing Configuration
MAX_FILE_SIZE_MB=10
PROCESSING_TIMEOUT_SECONDS=300

# Extraction Strategy
# Use prepared synthetic results (true) or real AI extraction (false)
USE_PREPARED_EXTRACTIONS=true
PREPARED_EXTRACTIONS_PATH=./synthetic-data/prepared-extractions/

# Feature Flags
ENABLE_REAL_OCR=false          # Use Tesseract/Textract vs prepared results
ENABLE_REAL_TRANSCRIPTION=false # Use Whisper/Transcribe vs prepared results
ENABLE_LLM_EXTRACTION=false     # Use LLM for entity extraction vs rule-based

# Security
SECRET_KEY=your-secret-key-change-this-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Logging
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# Database Connection Pool
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# LocalStack (for local AWS emulation, optional)
# AWS_ENDPOINT_URL=http://localhost:4566
