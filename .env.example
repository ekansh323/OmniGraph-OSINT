# Environment Configuration
ENVIRONMENT=development

# Storage Mode (local filesystem only)
STORAGE_MODE=local

# Local evidence storage directory
EVIDENCE_DIR=./evidence

# Database Configuration (local PostgreSQL via Docker)
DATABASE_URL=postgresql+asyncpg://admin:development@localhost:5432/omnigraph_osint

# API Configuration
API_BASE_URL=http://localhost:8000

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Processing Configuration
MAX_FILE_SIZE_MB=10
PROCESSING_TIMEOUT_SECONDS=300

# Extraction Strategy
# Use prepared synthetic results (true) or real AI extraction (false)
USE_PREPARED_EXTRACTIONS=true
PREPARED_EXTRACTIONS_PATH=./synthetic-data/prepared-extractions/

# Feature Flags
ENABLE_REAL_OCR=false           # Use Tesseract vs prepared results
ENABLE_REAL_TRANSCRIPTION=false # Use SpeechRecognition vs prepared results
ENABLE_LLM_EXTRACTION=false     # Use LLM for entity extraction vs rule-based

# Security
SECRET_KEY=your-secret-key-change-this-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Logging
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# Database Connection Pool
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
